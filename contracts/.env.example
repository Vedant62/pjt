# Used by forge scripts (copy to contracts/.env, which is gitignored)
TESTNET_CHAIN=11155111            # 11155111 = Ethereum Sepolia (default), 84532 = Base Sepolia
PRIVATE_KEY=0x...                 # deployer; anvil uses its default key 0
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=                # Etherscan v2 multichain key (verifies on Etherscan and BaseScan)
GATEWAY_ADDRESS=0x...             # committer for UsageRootRegistry
SUBSCRIBER_ADDRESSES=0x...,0x...  # comma-separated wallets Seed.s.sol mints mUSDC to
