# Used by forge scripts
PRIVATE_KEY=0x...                 # deployer (Base Sepolia); anvil uses its default key 0
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=                # Etherscan v2 multichain key (works for BaseScan)
GATEWAY_ADDRESS=0x...             # committer for UsageRootRegistry
SUBSCRIBER_ADDRESSES=0x...,0x...  # comma-separated wallets Seed.s.sol mints mUSDC to
